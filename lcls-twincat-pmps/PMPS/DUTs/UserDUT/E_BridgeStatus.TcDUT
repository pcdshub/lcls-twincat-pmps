<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4022.18">
  <DUT Name="E_BridgeStatus" Id="{5d6adaaf-7075-438d-856d-a489d0a9a0c4}">
    <Declaration><![CDATA[(* Combined bridge diagnostic verdict: LinkStatus gates DataStatus. *)
TYPE E_BridgeStatus :
(
    Connected,
    LocalNotOperational,
    ExternalDeviceNotConnected,
    RemoteNotOperational,
    LinkError,
    DataStale
) UDINT;
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
