<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4022.18">
  <DUT Name="E_BridgeLinkStatus" Id="{0b2a777c-5a9d-4624-86df-f7f2aa9e3cab}">
    <Declaration><![CDATA[(* Whether the bridge itself is established; local/remote operational state and device presence, before any data-quality signal is meaningful. *)
TYPE E_BridgeLinkStatus :
(
    Connected,                    // local State = OP, far device present, far side TxPDOState = 0 (OP)
    LocalNotOperational,          // local State <> OP
    ExternalDeviceNotConnected,   // far device not present
    RemoteNotOperational          // far device present but TxPDOState <> 0
) UDINT;
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
