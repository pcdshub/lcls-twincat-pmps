<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_FallibleUsintFromEtherCAT" Id="{a1b2c3d4-0104-4001-8001-000000000401}" SpecialFunc="None">
    <Declaration><![CDATA[
(* Passes one USINT read across the arbiter bridge. The caller links the raw PDO value and derives
   bridge health elsewhere (e.g. FB_SubSysToArbiter_IO.bBridgeOk) and passes both in each cycle; this
   FB owns no hardware links. Integers have no invalid-bit-pattern to sanitize, so it holds the last
   trusted value while the bridge is down. Error carries only the test override; fault on bad comms
   via the bridge FB's bBridgeConfirmedBad in the caller. *)
FUNCTION_BLOCK FB_FallibleUsintFromEtherCAT
IMPLEMENTS I_FallibleUsint
VAR_INPUT
    i_bBridgeOk : BOOL;
    i_nValue : USINT;
END_VAR
VAR_OUTPUT
    {attribute 'pytmc' := '
        pv: Value
        io: i
    '}
    nValue : USINT;
END_VAR
VAR
    nLastValidValue : USINT;
    bOverride : BOOL;
    bOverrideError : BOOL;
    nOverrideValue : USINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
IF i_bBridgeOk THEN
    nLastValidValue := i_nValue;
END_IF

nValue := SEL(bOverride, SEL(i_bBridgeOk, nLastValidValue, i_nValue), nOverrideValue);
]]></ST>
    </Implementation>
    <Property Name="Error" Id="{a1b2c3d4-0104-4001-8001-000000000402}">
      <Declaration><![CDATA[
PROPERTY Error : BOOL
]]></Declaration>
      <Get Name="Get" Id="{a1b2c3d4-0104-4001-8001-000000000403}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[
Error := SEL(bOverride, FALSE, bOverrideError);
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Value" Id="{a1b2c3d4-0104-4001-8001-000000000404}">
      <Declaration><![CDATA[
PROPERTY Value : USINT
]]></Declaration>
      <Get Name="Get" Id="{a1b2c3d4-0104-4001-8001-000000000405}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[
Value := THIS^.nValue;
]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>