<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4022.18">
  <POU Name="FB_SubSysToArbiter_IO" Id="{98769089-e42b-4685-9f83-c90a3cb7edad}" SpecialFunc="None">
    <Declaration><![CDATA[// Use on a subsystem PLC to request from the arbiter
// Run at the top of your cycle to receive the latest BP
// Also derives PMPS_PRE bridge health (bBridgeOk / bBridgeConfirmedBad) from the interface PDOs
FUNCTION_BLOCK FB_SubSysToArbiter_IO IMPLEMENTS I_HigherAuthority
VAR_INPUT
    Reset : BOOL; // Fast fault reset
    sName : STRING := 'SubSysToArbiter';
    i_bVeto : BOOL;
    // max time the TxPDO toggle may stay unchanged before inbound data is called stale
    tStaleTimeout : TIME := T#5S;
    // hold length after a CurrentBP.xValid falling edge before trusting health again, in task cycles
    nDebounceCycles : UDINT := 100;
END_VAR
VAR_OUTPUT
    // bridge up and inbound data valid, held FALSE through the post-xValid-drop debounce; gate consumers on this
    {attribute 'pytmc' := 'pv: BridgeOk
        io: i'
    }
    bBridgeOk : BOOL;
    // raw bad verdict with no debounce hold; use to trip faults
    {attribute 'pytmc' := 'pv: BridgeConfirmedBad
        io: i'
    }
    bBridgeConfirmedBad : BOOL;
    // bridge establishment state
    {attribute 'pytmc' := 'pv: LinkStatus
        io: i'
    }
    eLinkStatus : E_BridgeLinkStatus;
    // inbound PDO data quality
    {attribute 'pytmc' := 'pv: DataStatus
        io: i'
    }
    eDataStatus : E_DataStatus;
    // combined verdict, LinkStatus gates DataStatus
    {attribute 'pytmc' := 'pv: ConnectionStatus
        io: i'
    }
    eConnectionStatus : E_BridgeStatus;
END_VAR
VAR_IN_OUT
    Arbiter	: FB_Arbiter;
    fbFFHWO : FB_HardwareFFOutput;
END_VAR
VAR
    {attribute 'TcLinkTo' := 'TIIB[PMPS_PRE]^IO Inputs^CurrentBP'}
    i_stCurrentBP    AT %I* :    ST_BeamParams_IO;
    {attribute 'TcLinkTo' := 'TIIB[PMPS_PRE]^IO Outputs^RequestedBP'}
    q_stRequestedBP AT %Q* :    ST_BeamParams_IO;
    {attribute 'TcLinkTo' := 'TIIB[PMPS_PRE]^SYNC Inputs^TxPDO toggle'}
    xTxPDO_toggle    AT     %I* :    BIT;
    {attribute 'TcLinkTo' := 'TIIB[PMPS_PRE]^SYNC Inputs^TxPDO state'}
    xTxPDO_state    AT    %I*    :    BIT;


    // Fast faults
    ffPMPSIO_Disconnect : FB_FastFault := (i_Desc:='Arbiter network interface disconnected or not OP',i_DevName := sName);

    // A request is not considered included until the active cohort number is >= the request cohort number.
    {attribute 'pytmc' := 'pv: RequestCohort
        io: i'}
    nRequestCohort : UDINT := 0; // Request cohort
    {attribute 'pytmc' := 'pv: ActiveCohort
        io: i'}
    nActiveCohort : UDINT := 0; // Active cohort, updated by incoming BP from arbiter PLC, in the ElevateRequest arbiter call

    fbVetoArb : FB_VetoArbiter;

    fbLog : FB_LogMessage;

    // EL6692 local ESM state, low nibble is the EtherCAT state
    {attribute 'TcLinkTo' := 'TIIB[PMPS_PRE]^InfoData^State'}
    nBridgeState AT %I* : WORD;
    // far side of the bridge absent
    {attribute 'TcLinkTo' := 'TIIB[PMPS_PRE]^SYNC Inputs^External device not connected'}
    bExternalDeviceNotConnected AT %I* : BOOL;
    // inbound working counter error
    {attribute 'TcLinkTo' := 'TIIB[PMPS_PRE]^WcState^WcState'}
    bWcState AT %I* : BOOL;

    bTxPdoState : BOOL;
    bTxPdoToggle : BOOL;
    rToggleRise : R_TRIG;
    fToggleFall : F_TRIG;
    tonStale : TON;
    fXValidFall : F_TRIG;
    // TRUE while holding health low after an xValid drop until the debounce window elapses
    bSuspect : BOOL;
    nSuspectCycles : UDINT;
    bLiveDiagOk : BOOL;
    rBridgeBad : R_TRIG;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[//Receiving current BP state
PMPS_GVL.stCurrentBeamParameters := IO_TO_BP(i_stCurrentBP);
PMPS_GVL.stCurrentBeamParameters.xValidToggle := xTxPDO_toggle; // This line must follow the one above. Sequence is important.

// Forwarding BP request for the subsystem
fbVetoArb.bVeto := i_bVeto;
fbVetoArb(HigherAuthority:=THIS^, LowerAuthority:=Arbiter, FFO:=fbFFHWO);

//Broadcasting current request
PMPS_GVL.stRequestedBeamParameters := IO_TO_BP(q_stRequestedBP);


q_stRequestedBP.xValid := TRUE; // This is set and held true here every cycle to prove the PLC on this side is still running

ffPMPSIO_Disconnect(
    i_xOK := xTxPDO_state = 0,
    io_fbFFHWO := fbFFHWO,
    i_xReset := Reset,
    i_DevName := sName,
    i_TypeCode := 6,
    i_xVetoable := FALSE
    );

bTxPdoState := xTxPDO_state;
bTxPdoToggle := xTxPDO_toggle;

IF (nBridgeState AND 16#000F) <> E_EcCommState.eEcState_OP THEN
    eLinkStatus := E_BridgeLinkStatus.LocalNotOperational;
ELSIF bExternalDeviceNotConnected THEN
    eLinkStatus := E_BridgeLinkStatus.ExternalDeviceNotConnected;
ELSIF bTxPdoState THEN
    eLinkStatus := E_BridgeLinkStatus.RemoteNotOperational;
ELSE
    eLinkStatus := E_BridgeLinkStatus.Connected;
END_IF

rToggleRise(CLK := bTxPdoToggle);
fToggleFall(CLK := bTxPdoToggle);
tonStale(IN := NOT (rToggleRise.Q OR fToggleFall.Q), PT := tStaleTimeout);

IF bWcState THEN
    eDataStatus := E_DataStatus.WcError;
ELSIF tonStale.Q THEN
    eDataStatus := E_DataStatus.Stale;
ELSE
    eDataStatus := E_DataStatus.Ok;
END_IF

CASE eLinkStatus OF
    E_BridgeLinkStatus.LocalNotOperational:        eConnectionStatus := E_BridgeStatus.LocalNotOperational;
    E_BridgeLinkStatus.ExternalDeviceNotConnected: eConnectionStatus := E_BridgeStatus.ExternalDeviceNotConnected;
    E_BridgeLinkStatus.RemoteNotOperational:       eConnectionStatus := E_BridgeStatus.RemoteNotOperational;
ELSE
    CASE eDataStatus OF
        E_DataStatus.WcError: eConnectionStatus := E_BridgeStatus.LinkError;
        E_DataStatus.Stale:   eConnectionStatus := E_BridgeStatus.DataStale;
    ELSE
        eConnectionStatus := E_BridgeStatus.Connected;
    END_CASE
END_CASE

bLiveDiagOk := (eLinkStatus = E_BridgeLinkStatus.Connected) AND (eDataStatus = E_DataStatus.Ok);

fXValidFall(CLK := i_stCurrentBP.xValid);
IF fXValidFall.Q THEN
    bSuspect := TRUE;
    nSuspectCycles := 0;
END_IF

IF bSuspect THEN
    bBridgeOk := FALSE;
    nSuspectCycles := nSuspectCycles + 1;
    IF nSuspectCycles >= nDebounceCycles THEN
        bSuspect := FALSE;
        bBridgeOk := bLiveDiagOk;
    END_IF
ELSE
    bBridgeOk := bLiveDiagOk;
END_IF

bBridgeConfirmedBad := NOT bLiveDiagOk;

rBridgeBad(CLK := bBridgeConfirmedBad);
IF rBridgeBad.Q THEN
    fbLog(sMsg := CONCAT(sName, ': arbiter bridge confirmed bad, PMPS_PRE link or data lost'), eSevr := TcEventSeverity.Error);
END_IF]]></ST>
    </Implementation>
    <Method Name="CheckRequest" Id="{27cbc3cc-3c51-453f-b2eb-a076b6901ac4}">
      <Declaration><![CDATA[METHOD CheckRequest : BOOL
VAR_INPUT
    nReqID	: DWORD;
END_VAR
VAR_INST
    xFirstTime : BOOL := TRUE;
    nId : DWORD;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Check this id matches what we've seen before
IF xFirstTime THEN
    nId := nReqId;
ELSIF nId <> nReqId THEN
    fbLog(sMsg := 'SubSysToArbiter Check mismatched with a different ID', eSevr := TcEventSeverity.Error);
    RETURN;
END_IF

nActiveCohort := ULINT_TO_UDINT(i_stCurrentBP.nCohortInt);

// i_stCurrentBP.nCohortInt is incremented by the FB_ArbiterToSubSys block on the other side of the EL669* interface
CheckRequest := nRequestCohort <= nActiveCohort;]]></ST>
      </Implementation>
    </Method>
    <Method Name="RemoveRequest" Id="{d73fcee0-bda0-40f1-90f5-f8e021f35983}">
      <Declaration><![CDATA[METHOD RemoveRequest : BOOL
VAR_INPUT
    nReqID    :    DWORD; //StateID to remove
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Update internal BP request struct
q_stRequestedBP := BP_TO_IO(PMPS_GVL.cstFullBeam);

nRequestCohort := nRequestCohort + 1;

// Mark the current cohort id
q_stRequestedBP.nCohortInt := nRequestCohort;

RemoveRequest := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestBP" Id="{e2fc147e-ed0b-480c-b8bb-db22a7cb743b}">
      <Declaration><![CDATA[METHOD RequestBP : BOOL
VAR_INPUT
    (*StateID of state requesting beam parameter set*)
    nReqID	: DWORD;
    (*Requested beam params*)
    stReqBP	: ST_BeamParams;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Check the request is coming from the same source we're used to

// Update internal BP request struct
q_stRequestedBP := BP_TO_IO(stReqBP);

nRequestCohort := nRequestCohort + 1;

// Mark the current cohort id
q_stRequestedBP.nCohortInt := nRequestCohort;

RequestBP := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>